    {
      "parameters": {
        "jsCode": "const output = $input.first().json.output;\n\n// Remove markdown code fences if the AI adds them\nconst cleanOutput = output\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\n// Convert AI's JSON text into an actual object\nconst data = JSON.parse(cleanOutput);\n\n// Generate a unique Test ID\nconst testId = `TEST-${Date.now()}`;\n\nreturn [\n  {\n    json: {\n      test_id: testId,\n      question: data.question,\n      ai_answer: data.ai_answer,\n      result: data.result\n    }\n  }\n];"
      },
